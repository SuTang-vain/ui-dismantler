  "scenarios": [
    {
      "id": "unauthenticated-dashboard-guard",
      "entryPath": "/#/dashboard",
      "steps": [
        {
          "action": "wait",
          "ms": 100
        }
      ],
      "assertions": {
        "path": "/#/login?redirect=/dashboard",
        "visibleSelector": {
          "reference": ".login-container",
          "generated": ".login-container"
        },
        "visibleText": "Login"
      },
      "visual": {
        "screenshotAnchor": ".login-container",
        "screenshotRegion": ".login-container",
        "styleTargets": [
          {
            "id": "login",
            "selector": ".login-container"
          },
          {
            "id": "login-form",
            "selector": ".login-form"
          }
        ]
      }
    },
    {
      "id": "nested-route-navigation",
      "entryPath": "/#/dashboard",
      "steps": [
        {
          "action": "click",
          "target": "a[href='#/nested/menu1/menu1-1']"
        }
      ],
      "assertions": {
        "path": "/#/nested/menu1/menu1-1",
        "visibleSelector": ".app-main"
      },
      "visual": {
        "screenshotAnchor": ".app-main",
        "screenshotRegion": "#app",
        "styleTargets": [
          {
            "id": "sidebar",
            "selector": ".sidebar-container"
          },
          {
            "id": "main",
            "selector": ".app-main"
          }
        ]
      }
    },
    {
      "id": "history-back-dashboard",
      "entryPath": "/#/dashboard",
      "steps": [
        {
          "action": "click",
          "target": "a[href='#/documentation/index']"
        },
        {
          "action": "back"
        }
      ],
      "assertions": {
        "path": "/#/dashboard",
        "visibleSelector": ".dashboard-container"
      }
    },
    {
      "id": "dynamic-article-route",
      "entryPath": "/#/example/list",
      "steps": [
        {
          "action": "click",
          "target": "a[href='#/example/edit/123']"
        }
      ],
      "assertions": {
        "path": "/#/example/edit/123",
        "visibleSelector": ".createPost-container"
      }
    },
    {
      "id": "deep-link-reload",
      "entryPath": "/#/permission/directive",
      "steps": [
        {
          "action": "reload"
        }
      ],
      "assertions": {
        "path": "/#/permission/directive",
        "visibleSelector": ".app-main"
      },
      "visual": {
        "screenshotAnchor": ".app-main",
        "screenshotRegion": "#app",
        "styleTargets": [
          {
            "id": "sidebar",
            "selector": ".sidebar-container"
          },
          {
            "id": "main",
            "selector": ".app-main"
          }
        ]
      }
    }
  ],
