{
  "schemaVersion": "1.0",
  "navigationComparison": "semantic",
  "execution": {
    "contractConcurrency": 3,
    "browserShutdown": "fast-kill",
    "actionTimeoutMs": 5000,
    "visualConcurrency": 3,
    "visualCaptureConcurrency": 3,
    "visualCanvasConcurrency": 2,
    "visualPixelConcurrency": 1
  },
  "scenarios": [
    {
      "id": "unauthenticated-dashboard-guard",
      "entryPath": "/#/dashboard",
      "steps": [
        {
          "action": "wait",
          "ms": 250
        }
      ],
      "assertions": {
        "path": "/",
        "hash": "#/login?redirect=%2Fdashboard",
        "visibleSelector": ".login-container",
        "visibleText": "Login"
      },
      "visual": {
        "screenshotAnchor": ".login-container",
        "screenshotRegion": ".login-container",
        "styleTargets": [
          {
            "id": "login",
            "selector": ".login-container"
          },
          {
            "id": "login-form",
            "selector": ".login-form"
          }
        ],
        "resourceProfile": "dom"
      }
    },
    {
      "id": "admin-login-dashboard",
      "entryPath": "/#/login",
      "steps": [
        {
          "action": "input",
          "target": "input[placeholder='Username']",
          "value": "admin"
        },
        {
          "action": "input",
          "target": "input[placeholder='Password']",
          "value": "123456"
        },
        {
          "action": "click",
          "target": "button.el-button--primary:not(.thirdparty-button)"
        }
      ],
      "assertions": {
        "path": "/",
        "hash": "#/dashboard",
        "visibleSelector": ".dashboard-container",
        "visibleText": "Dashboard"
      },
      "visual": {
        "screenshotAnchor": ".dashboard-container",
        "screenshotRegion": ".app-main",
        "styleTargets": [
          {
            "id": "main",
            "selector": ".app-main"
          },
          {
            "id": "dashboard",
            "selector": ".dashboard-container"
          }
        ],
        "reuseStateKey": "authenticated-dashboard-default",
        "resourceProfile": "canvas"
      },
      "setupState": {
        "stateKey": "authenticated-admin",
        "checkpointStepCount": 3,
        "resumePath": "/#/dashboard",
        "checkpointAssertions": {
          "hash": "#/dashboard",
          "visibleSelector": ".dashboard-container"
        }
      }
    },
