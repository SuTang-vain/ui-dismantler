  "scenarios": [
    {
      "id": "admin-login-dashboard",
      "entryPath": "/#/login",
      "steps": [
        {
          "action": "input",
          "target": "input[placeholder='Username']",
          "value": "admin"
        },
        {
          "action": "input",
          "target": "input[placeholder='Password']",
          "value": "123456"
        },
        {
          "action": "click",
          "target": "button.el-button--primary:not(.thirdparty-button)"
        }
      ],
      "assertions": {
        "path": "/",
        "hash": "#/dashboard",
        "visibleSelector": ".dashboard-container",
        "visibleText": "Dashboard"
      },
