{
  "schemaVersion": "1.0",
  "navigationComparison": "semantic",
  "execution": {
    "contractConcurrency": 1,
    "browserShutdown": "graceful",
    "actionTimeoutMs": 5000
  },
  "scenarios": [
    {
      "id": "unauthenticated-dashboard-guard",
      "entryPath": "/#/dashboard",
      "steps": [
        {
          "action": "wait",
          "ms": 250
        }
      ],
      "assertions": {
        "path": "/",
        "hash": "#/login?redirect=%2Fdashboard",
        "visibleSelector": ".login-container",
        "visibleText": "Login"
      }
    },
    {
      "id": "admin-login-dashboard",
      "entryPath": "/#/login",
      "steps": [
        {
          "action": "input",
          "target": "input[placeholder='Username']",
          "value": "admin"
        },
        {
          "action": "input",
          "target": "input[placeholder='Password']",
          "value": "123456"
        },
        {
          "action": "click",
          "target": "button.el-button--primary:not(.thirdparty-button)"
        }
      ],
      "assertions": {
        "path": "/",
        "hash": "#/dashboard",
        "visibleSelector": ".dashboard-container",
        "visibleText": "Dashboard"
      }
    },
    {
      "id": "admin-nested-route",
      "entryPath": "/#/login",
      "steps": [
        {
          "action": "input",
          "target": "input[placeholder='Username']",
          "value": "admin"
        },
        {
          "action": "input",
          "target": "input[placeholder='Password']",
          "value": "123456"
        },
        {
          "action": "click",
          "target": "button.el-button--primary:not(.thirdparty-button)"
        },
        {
          "action": "click",
          "target": ".el-submenu__title:has-text('Nested Routes')"
        },
        {
          "action": "click",
          "target": ".el-submenu__title:has-text('Menu 1')"
        },
        {
          "action": "click",
          "target": "a[href='#/nested/menu1/menu1-1']"
        }
      ],
      "assertions": {
        "path": "/",
        "hash": "#/nested/menu1/menu1-1",
        "visibleSelector": ".app-main",
        "visibleText": "Menu 1-1"
      }
    },
    {
      "id": "admin-history-back",
      "entryPath": "/#/login",
      "steps": [
        {
          "action": "input",
          "target": "input[placeholder='Username']",
          "value": "admin"
        },
        {
          "action": "input",
          "target": "input[placeholder='Password']",
          "value": "123456"
        },
        {
          "action": "click",
          "target": "button.el-button--primary:not(.thirdparty-button)"
        },
        {
          "action": "click",
          "target": "a[href='#/documentation/index']"
        },
        {
          "action": "back"
        }
      ],
      "assertions": {
        "path": "/",
        "hash": "#/dashboard",
        "visibleSelector": ".dashboard-container",
        "visibleText": "Dashboard"
      }
    },
    {
      "id": "admin-permission-route",
      "entryPath": "/#/login",
      "steps": [
        {
          "action": "input",
          "target": "input[placeholder='Username']",
          "value": "admin"
        },
        {
          "action": "input",
          "target": "input[placeholder='Password']",
          "value": "123456"
        },
        {
          "action": "click",
          "target": "button.el-button--primary:not(.thirdparty-button)"
        },
        {
          "action": "click",
          "target": ".el-submenu__title:has-text('Permission')"
        },
        {
          "action": "click",
          "target": "a[href='#/permission/directive']"
        }
      ],
      "assertions": {
        "path": "/",
        "hash": "#/permission/directive",
        "visibleSelector": ".app-main",
        "visibleText": "Directive Permission"
      }
    },
    {
      "id": "admin-deep-link-reload",
      "entryPath": "/#/login",
      "steps": [
        {
          "action": "input",
          "target": "input[placeholder='Username']",
          "value": "admin"
        },
        {
          "action": "input",
          "target": "input[placeholder='Password']",
          "value": "123456"
        },
        {
          "action": "click",
          "target": "button.el-button--primary:not(.thirdparty-button)"
        },
        {
          "action": "reload"
        }
      ],
      "assertions": {
        "path": "/",
        "hash": "#/dashboard",
        "visibleSelector": ".dashboard-container",
        "visibleText": "Dashboard"
      }
    }
  ],
