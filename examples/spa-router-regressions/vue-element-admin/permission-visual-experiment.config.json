  "scenarios": [
    {
      "id": "admin-permission-route",
      "entryPath": "/#/login",
      "steps": [
        {
          "action": "input",
          "target": "input[placeholder='Username']",
          "value": "admin"
        },
        {
          "action": "input",
          "target": "input[placeholder='Password']",
          "value": "123456"
        },
        {
          "action": "click",
          "target": "button.el-button--primary:not(.thirdparty-button)"
        },
        {
          "action": "click",
          "target": ".el-submenu__title:has-text('Permission')"
        },
        {
          "action": "click",
          "target": "a[href='#/permission/directive']"
        }
      ],
      "assertions": {
        "path": "/",
        "hash": "#/permission/directive",
        "visibleSelector": ".app-main",
        "visibleText": "Directive Permission"
      },
