            "selector": ".app-main"
          }
        ],
        "viewports": [
          "desktop",
          "tablet"
        ]
      }
    },
    {
      "id": "admin-deep-link-reload",
      "entryPath": "/#/login",
      "steps": [
        {
          "action": "input",
          "target": "input[placeholder='Username']",
          "value": "admin"
        },
        {
          "action": "input",
          "target": "input[placeholder='Password']",
          "value": "123456"
        },
        {
          "action": "click",
          "target": "button.el-button--primary:not(.thirdparty-button)"
        },
        {
          "action": "reload"
        }
      ],
      "assertions": {
        "path": "/",
        "hash": "#/dashboard",
        "visibleSelector": ".dashboard-container",
        "visibleText": "Dashboard"
      },
      "visual": {
        "screenshotAnchor": ".dashboard-container",
        "screenshotRegion": ".app-main",
        "styleTargets": [
          {
            "id": "main",
            "selector": ".app-main"
          },
          {
            "id": "dashboard",
            "selector": ".dashboard-container"
          }
        ]
      }
    }
  ],
  "visualMatrix": {
    "pixelThreshold": 0.02,
    "styleThreshold": 0.98,
