  "scenarios": [
    {
      "id": "router-link-explore",
      "entryPath": "/settings",
      "steps": [
        {
          "action": "click",
          "target": "a[href='/explore']"
        }
      ],
      "assertions": {
        "path": "/explore",
        "visibleText": "发现",
        "visibleSelector": "a[href='/explore'].active"
      },
      "visual": {
        "screenshotAnchor": ".explore-page",
        "styleTargets": [
          {
            "id": "app-nav",
            "selector": "nav"
          },
          {
            "id": "route-main",
            "selector": "main"
          },
          {
            "id": "explore-page",
            "selector": ".explore-page"
          }
        ]
      }
    },
    {
      "id": "router-go-back",
      "entryPath": "/settings",
      "steps": [
        {
          "action": "click",
          "target": "a[href='/explore']"
        },
        {
          "action": "back"
        }
      ],
      "assertions": {
        "path": "/settings",
        "visibleText": "语言"
      }
    },
    {
      "id": "dynamic-search-route",
      "entryPath": "/settings",
      "steps": [
        {
          "action": "input",
          "target": "input[type='search']",
          "value": "周杰伦"
        },
        {
          "action": "key",
          "target": "input[type='search']",
          "key": "Enter"
        }
      ],
      "assertions": {
        "path": "/search/%E5%91%A8%E6%9D%B0%E4%BC%A6",
        "inputValue": {
          "target": "input[type='search']",
          "value": "周杰伦"
        }
      }
    },
    {
      "id": "login-guard-redirect",
      "entryPath": "/settings",
      "steps": [
        {
          "action": "click",
          "target": "a[href='/library']"
        }
      ],
      "assertions": {
        "path": "/login",
        "visibleText": "登录网易云账号"
      },
      "visual": {
        "screenshotAnchor": ".login",
        "styleTargets": [
          {
            "id": "app-nav",
            "selector": "nav"
          },
          {
            "id": "route-main",
            "selector": "main"
          },
          {
            "id": "login-page",
            "selector": ".login"
          }
        ]
      }
    },
    {
      "id": "history-deep-link-reload",
      "entryPath": "/settings",
      "steps": [
        {
          "action": "reload"
        }
      ],
      "assertions": {
        "path": "/settings",
        "visibleText": "语言"
      },
      "visual": {
        "screenshotAnchor": ".settings-page",
        "styleTargets": [
          {
            "id": "app-nav",
            "selector": "nav"
          },
          {
            "id": "route-main",
            "selector": "main"
          },
          {
            "id": "settings-page",
            "selector": ".settings-page"
          }
        ]
      }
    }
  ],
